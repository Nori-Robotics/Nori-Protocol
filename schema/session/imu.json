{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nori.dev/protocol/session/imu.json",
  "title": "imu",
  "description": "Robot -> client. Rate-limited sensor_msgs/Imu from /imu/data, preserving frame, timestamp, quaternion, SI vectors and covariance arrays.",
  "type": "object",
  "required": ["type", "stamp", "frame_id", "orientation_xyzw", "orientation_covariance", "angular_velocity_rad_s", "angular_velocity_covariance", "linear_acceleration_m_s2", "linear_acceleration_covariance"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "imu" },
    "stamp": {
      "type": "object",
      "required": ["sec", "nanosec"],
      "additionalProperties": false,
      "properties": {
        "sec": { "type": "integer", "minimum": 0 },
        "nanosec": { "type": "integer", "minimum": 0, "maximum": 999999999 }
      }
    },
    "frame_id": { "type": "string" },
    "orientation_xyzw": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": ["number", "null"] } },
    "orientation_covariance": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": ["number", "null"] } },
    "angular_velocity_rad_s": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": ["number", "null"] } },
    "angular_velocity_covariance": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": ["number", "null"] } },
    "linear_acceleration_m_s2": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": ["number", "null"] } },
    "linear_acceleration_covariance": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": ["number", "null"] } }
  }
}
